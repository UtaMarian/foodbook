{
  "name": "@foodbook/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "rimraf dist tsconfig.build.tsbuildinfo && tsc -p tsconfig.build.json",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:migrate": "prisma migrate dev",
    "typecheck": "tsc --noEmit",
    "cleanup:orphans": "ts-node scripts/cleanup-orphans.ts",
    "seed": "ts-node scripts/seed.ts",
    "promote-admin": "ts-node scripts/promote-admin.ts"
  },
  "dependencies": {
    "@foodbook/shared": "*",
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.4",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/throttler": "^5.2.0",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^5.20.0",
    "@supabase/supabase-js": "^2.45.4",
    "dotenv": "^16.4.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.33.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.7.4",
    "prisma": "^5.20.0",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
